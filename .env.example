# Copy to .env for `docker compose up`. Every line is optional: the app runs
# with no .env at all. Nothing here is a secret, and nothing here should be.

# Port on your machine. The container itself always listens on 8080.
APP_PORT=8080

# Public host name for the share-card and install tags the server adds to each
# page. Unset, it uses the request's Host header, and localhost gets no card.
# VITE_PUBLIC_HOSTNAME=manual.example.com

# There is no database. Leave DATABASE_URL unset.
